<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Navigation Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- App Branding (Constrained to start of tabs so it never collides or truncates) -->
        <LinearLayout
            android:id="@+id/layoutBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/layoutTopActions"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_app_logo" />

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="武士の響 · Samurai Edition"
                android:textColor="@color/primary_accent"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Top Actions: Wi-Fi Sync + Tab Switcher -->
        <LinearLayout
            android:id="@+id/layoutTopActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnOpenSync"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_search"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_wifi_sync"
                android:tint="@color/accent_gold" />

            <LinearLayout
                android:id="@+id/layoutTabs"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill_search"
                android:padding="2dp">

                <TextView
                    android:id="@+id/btnTabPlayer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_tab_active"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Trình phát"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnTabLibrary"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_tab_inactive"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Thư viện"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Thin Katana Line Accent -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color" />

    <!-- Main Content Area: Tab 1 (Full Samurai Player) vs Tab 2 (Song Library) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= TAB 1: FULL SAMURAI PLAYER ================= -->
        <ScrollView
            android:id="@+id/layoutPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp">

                <!-- Playing Status Indicator -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:id="@+id/dotPulse"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_play_btn"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvPlayerBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/now_playing"
                        android:textColor="@color/primary_accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />
                </LinearLayout>

                <!-- Central Majestic Rotating Tsuba Disc -->
                <FrameLayout
                    android:id="@+id/layoutDiscContainer"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_marginVertical="14dp">

                    <!-- Ambient Glow Ring -->
                    <View
                        android:id="@+id/viewTsubaGlow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_tsuba_glow" />

                    <!-- Photorealistic Antique Katana Tsuba Sword Guard (Spins smoothly) -->
                    <ImageView
                        android:id="@+id/viewVinylDisc"
                        android:layout_width="230dp"
                        android:layout_height="230dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_tsuba_disc" />
                </FrameLayout>

                <!-- Song Title & Artist -->
                <TextView
                    android:id="@+id/tvSheetTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:ellipsize="marquee"
                    android:gravity="center"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="The Way of the Ghost"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSheetArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="⚔️ Ilan Eshkeri (Ghost of Tsushima)"
                    android:textColor="@color/accent_gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Audio Output Routing Pill Button -->
                <LinearLayout
                    android:id="@+id/btnAudioOutput"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pill_search"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/ivOutputIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_speaker"
                        android:tint="@color/accent_gold" />

                    <TextView
                        android:id="@+id/tvOutputDeviceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Loa ngoài điện thoại"
                        android:textColor="@color/accent_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_chevron_down"
                        android:tint="@color/text_muted" />
                </LinearLayout>

                <!-- Katana Seekbar & Timestamps -->
                <!-- Authentic Katana Sword Playback Seekbar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <!-- Visual Katana Sword Assembly (Chuôi kiếm - Thân kiếm SeekBar - Mũi kiếm) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Katana Tsuka (Chuôi kiếm bên trái) -->
                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="22dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_katana_tsuka_left" />

                        <!-- Katana Blade SeekBar (Lưỡi kiếm chính) -->
                        <SeekBar
                            android:id="@+id/seekBarPlayer"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:maxHeight="8dp"
                            android:minHeight="8dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:progressDrawable="@drawable/seek_bar_katana_track"
                            android:thumb="@drawable/ic_katana_thumb"
                            android:splitTrack="false" />

                        <!-- Katana Kissaki (Mũi kiếm vát nhọn bên phải) -->
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="22dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_katana_kissaki_right" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:id="@+id/tvCurrentTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:fontFamily="monospace"
                            android:text="00:00"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="KATANA · 刀"
                            android:textColor="@color/primary_accent"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.2" />

                        <TextView
                            android:id="@+id/tvTotalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="monospace"
                            android:text="00:00"
                            android:textColor="@color/accent_gold"
                            android:textSize="12sp" />
                    </RelativeLayout>
                </LinearLayout>

                <!-- Control Buttons Cluster -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="5">

                    <!-- Shuffle (Ran - 乱) -->
                    <ImageView
                        android:id="@+id/btnShuffle"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:src="@drawable/ic_shuffle"
                        android:tint="@color/text_muted" />

                    <!-- Previous Track -->
                    <ImageView
                        android:id="@+id/btnPrevious"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:src="@drawable/ic_skip_previous"
                        android:tint="@color/text_primary" />

                    <!-- Play / Pause (Big Crimson Button with Gold Rim) -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center">

                        <ImageButton
                            android:id="@+id/btnPlayPauseLarge"
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_play_btn"
                            android:elevation="8dp"
                            android:padding="18dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_play"
                            android:tint="@color/white" />
                    </FrameLayout>

                    <!-- Next Track -->
                    <ImageView
                        android:id="@+id/btnNext"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:src="@drawable/ic_skip_next"
                        android:tint="@color/text_primary" />

                    <!-- Repeat (Jun - 巡) -->
                    <ImageView
                        android:id="@+id/btnRepeat"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:src="@drawable/ic_repeat"
                        android:tint="@color/primary_accent" />
                </LinearLayout>

                <!-- Bushido Tagline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="“Kiếm bén nhờ mài · Nhạc hay nhờ lòng”"
                    android:textColor="@color/accent_gold"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:alpha="0.85" />

            </LinearLayout>
        </ScrollView>

        <!-- ================= TAB 2: SONG LIBRARY ================= -->
        <LinearLayout
            android:id="@+id/layoutLibraryView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginHorizontal="18dp"
                android:layout_marginVertical="10dp"
                android:background="@drawable/bg_pill_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/accent_gold" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btnRefresh"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/accent_gold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSongCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="6dp"
                android:text="0 khúc nhạc"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Song List / Empty State -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSongs"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="80dp"
                    android:scrollbars="vertical" />

                <LinearLayout
                    android:id="@+id/layoutEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:alpha="0.8"
                        android:src="@drawable/ic_katana"
                        android:tint="@color/primary_accent" />

                    <TextView
                        android:id="@+id/tvEmptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/no_songs_found"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEmptyMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/permission_required"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantPermission"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:backgroundTint="@color/primary_accent"
                        android:text="@string/grant_permission"
                        android:textColor="@color/white"
                        app:cornerRadius="20dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Bottom Mini Player (Visible when browsing Library) -->
            <LinearLayout
                android:id="@+id/miniPlayerLayout"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_mini_player"
                android:clickable="true"
                android:elevation="8dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_tsuba_disc" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMiniTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:text="Tên khúc nhạc"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMiniArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Kiếm khách"
                        android:textColor="@color/accent_gold"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnMiniPlayPause"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/ic_play"
                    android:tint="@color/primary_accent" />

                <ImageView
                    android:id="@+id/btnMiniNext"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/ic_skip_next"
                    android:tint="@color/accent_gold" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>