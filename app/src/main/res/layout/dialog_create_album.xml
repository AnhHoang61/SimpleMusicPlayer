<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvDialogAlbumHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tạo Album Chủ Đề Mới"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Đặt tên album theo cảm xúc, phong cách hoặc thời điểm nghe nhạc."
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <!-- Emoji Selector Row -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Biểu tượng chủ đề:"
        android:textColor="@color/accent_gold"
        android:textSize="12sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutEmojiSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tab_active"
                android:gravity="center"
                android:tag="⚔️"
                android:text="⚔️"
                android:textSize="20sp" />

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_search"
                android:gravity="center"
                android:tag="🌙"
                android:text="🌙"
                android:textSize="20sp" />

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_search"
                android:gravity="center"
                android:tag="🔥"
                android:text="🔥"
                android:textSize="20sp" />

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_search"
                android:gravity="center"
                android:tag="🎧"
                android:text="🎧"
                android:textSize="20sp" />

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_search"
                android:gravity="center"
                android:tag="🍃"
                android:text="🍃"
                android:textSize="20sp" />

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_search"
                android:gravity="center"
                android:tag="🌸"
                android:text="🌸"
                android:textSize="20sp" />

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_search"
                android:gravity="center"
                android:tag="☕"
                android:text="☕"
                android:textSize="20sp" />

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_search"
                android:gravity="center"
                android:tag="🚗"
                android:text="🚗"
                android:textSize="20sp" />

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_pill_search"
                android:gravity="center"
                android:tag="💖"
                android:text="💖"
                android:textSize="20sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Album Name Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tên Album chủ đề:"
        android:textColor="@color/accent_gold"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogAlbumName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_search"
        android:hint="Ví dụ: Nhạc Thiền Samurai..."
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDialogAlbumCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Hủy"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnDialogAlbumSave"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_tab_active"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="Lưu Album"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
